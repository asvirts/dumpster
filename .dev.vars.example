# Local secrets for Astro / Wrangler (do not commit real keys)

# Local only: ADMIN_BYPASS works only with `astro dev` (import.meta.env.DEV)
ADMIN_BYPASS=1
ADMIN_NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=

# Production admin: verify Cloudflare Access JWT (required when not in DEV bypass)
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD tag>

# Clerk (optional in keyless/dev; required for production portal)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (required to unlock paid leads)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEAD_PRICE_CENTS=2500
