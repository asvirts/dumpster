# Local secrets for Astro / Wrangler (do not commit real keys)

# Local only: ADMIN_BYPASS works only with `astro dev` (import.meta.env.DEV)
ADMIN_BYPASS=1
ADMIN_NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=

# Production admin: verify Cloudflare Access JWT (required when not in DEV bypass)
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD tag>

# Clerk (optional in keyless/dev; required for production portal)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Base URL for email links and Stripe Checkout return URLs (default https://findadumpster.net).
# Set locally, or paying in test mode returns you to the production site.
PUBLIC_SITE_URL=http://localhost:4321

# Stripe (required to unlock paid leads). Local testing: docs/payments-testing.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEAD_PRICE_CENTS=2500
LEAD_PRICE_EXCLUSIVE_CENTS=4000
# 1 = email the admin about every lead (default: daily digest only)
# ADMIN_LEAD_ALERTS=1

# Transactional email from-address (verify the domain on Resend; later Cloudflare Email)
LEAD_FROM_EMAIL=Find A Dumpster <leads@findadumpster.net>

# Optional Cloudflare Turnstile (omit both to skip captcha)
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Replies via Resend Inbound (docs/leads.md → Replies)
# LEAD_REPLY_TO=leads@eeildoiint.resend.app
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_RECEIVING_API_KEY=
