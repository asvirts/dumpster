---
import '../styles/global.css';
import { BRAND } from '../lib/constants';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/operators', label: 'Operators' },
  { href: '/admin/leads', label: 'Leads' },
  { href: '/admin/import', label: 'Import' },
  { href: '/admin/cities', label: 'Cities' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · {BRAND.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-100 text-ink antialiased">
    <div class="flex min-h-screen">
      <aside class="hidden w-56 shrink-0 border-r border-border bg-white p-4 md:block">
        <a href="/admin" class="block text-lg font-bold text-ink no-underline">{BRAND.name}</a>
        <p class="mt-0.5 text-xs text-muted">Admin · verification first</p>
        <nav class="mt-8 space-y-1" aria-label="Admin">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'block rounded-lg px-3 py-2 text-sm font-medium no-underline',
                  path === n.href || (n.href !== '/admin' && path.startsWith(n.href))
                    ? 'bg-brand-50 text-brand-800'
                    : 'text-slate-600 hover:bg-surface',
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <a href="/" class="mt-8 block text-xs text-muted no-underline hover:text-brand-700"
          >← Public site</a
        >
      </aside>
      <div class="flex-1">
        <header class="border-b border-border bg-white px-4 py-3 md:px-8">
          <div class="flex items-center justify-between gap-4">
            <h1 class="text-lg font-bold text-ink">{title}</h1>
            <p class="text-xs text-muted">
              {Astro.locals.adminEmail ?? 'admin'}
            </p>
          </div>
          <nav class="mt-3 flex gap-2 overflow-x-auto md:hidden" aria-label="Admin mobile">
            {
              nav.map((n) => (
                <a href={n.href} class="btn-secondary shrink-0 px-3 py-1.5 text-xs">
                  {n.label}
                </a>
              ))
            }
          </nav>
        </header>
        <div class="p-4 md:p-8">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
