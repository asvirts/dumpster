---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OperatorCard from '../../../components/OperatorCard.astro';
import MapView from '../../../components/MapView.astro';
import SearchForm from '../../../components/SearchForm.astro';
import { getDb } from '../../../lib/db';
import { getCityWithOperators } from '../../../lib/search';
import { breadcrumbJsonLd, itemListJsonLd, pageTitle } from '../../../lib/seo';

const { state, city: citySlug } = Astro.params;
if (!state || !citySlug) return Astro.redirect('/search');

const db = getDb();
const data = await getCityWithOperators(db, state.toLowerCase(), citySlug.toLowerCase());
if (!data) return new Response(null, { status: 404, statusText: 'Not Found' });

const { city, operators: ops } = data;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;

const title = pageTitle([`${city.name} Dumpster Rental`, 'Verified Operators']);
const description =
  city.typicalPricingNotes?.slice(0, 155) ||
  `Find verified dumpster rental operators in ${city.name}, ${city.state}. Local permit notes, pricing ranges, and transparent filters.`;

const markers = ops
  .filter((o) => o.hqLat != null && o.hqLng != null)
  .map((o) => ({
    id: o.id,
    name: o.name,
    slug: o.slug,
    lat: o.hqLat as number,
    lng: o.hqLng as number,
  }));

const jsonLd = [
  itemListJsonLd(
    ops.map((o) => ({
      name: o.name,
      url: `${siteUrl}/operator/${o.slug}`,
    })),
    `Dumpster rentals in ${city.name}, ${city.state}`,
  ),
  breadcrumbJsonLd([
    { name: 'Home', url: siteUrl },
    { name: city.state, url: `${siteUrl}/search?q=${encodeURIComponent(city.state)}` },
    {
      name: city.name,
      url: `${siteUrl}/dumpster-rental/${city.stateSlug}/${city.slug}`,
    },
  ]),
];

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=86400',
);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="border-b-2 border-charcoal-900 bg-charcoal-900 py-12 text-white">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="font-mono text-xs uppercase tracking-widest text-charcoal-400">
        <a href="/" class="text-charcoal-400 no-underline hover:text-brand-400">Home</a>
        <span class="mx-2 text-charcoal-600">/</span>
        <a
          href={`/search?q=${encodeURIComponent(city.state)}`}
          class="text-charcoal-400 no-underline hover:text-brand-400">{city.state}</a
        >
        <span class="mx-2 text-charcoal-600">/</span>
        <span class="text-brand-400">{city.name}</span>
      </nav>
      <p class="eyebrow mt-6 text-brand-400">{city.name}, {city.state}</p>
      <h1 class="mt-3 font-display text-3xl uppercase leading-tight tracking-tight sm:text-5xl">
        Dumpster rental in <span class="text-brand-500">{city.name}</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-charcoal-200">
        Verified local operators with transparent pricing ranges, driveway notes, and city-specific permit
        guidance.
      </p>
      <div class="mt-7 max-w-xl border-2 border-charcoal-600 bg-charcoal-800 p-3">
        <SearchForm initialQ={`${city.name}, ${city.state}`} />
      </div>
      <p class="mt-4 font-mono text-xs uppercase tracking-widest text-charcoal-400">
        {ops.length} verified operator{ops.length === 1 ? '' : 's'} listed · brokers excluded
      </p>
    </div>
  </div>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[1fr_340px]">
    <div class="space-y-10">
      <section class="grid gap-5 sm:grid-cols-2">
        <div class="card p-6">
          <p class="eyebrow text-brand-600">Spec 01</p>
          <h2 class="mt-2 font-display text-xl uppercase tracking-tight text-ink">
            Local pricing snapshot
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-charcoal-700">
            {city.typicalPricingNotes || 'Pricing varies by size, weight, and dump fees. Compare ranges on operator profiles and always confirm an all-in quote.'}
          </p>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-brand-600">Spec 02</p>
          <h2 class="mt-2 font-display text-xl uppercase tracking-tight text-ink">Permit notes</h2>
          <p class="mt-3 text-sm leading-relaxed text-charcoal-700">
            {city.localPermitSummary || 'Street placement often requires a municipal right-of-way permit. Private driveway placement is usually simpler — confirm with your city and the operator.'}
          </p>
        </div>
      </section>

      {
        city.specialRules && (
          <section class="border-2 border-charcoal-900 bg-hazard shadow-[4px_4px_0_0_#121417]">
            <div class="hazard-bar" aria-hidden="true" />
            <div class="p-6">
              <h2 class="font-display text-xl uppercase tracking-tight text-charcoal-900">
                Local tips
              </h2>
              <p class="mt-2 text-sm font-medium leading-relaxed text-charcoal-900">
                {city.specialRules}
              </p>
            </div>
          </section>
        )
      }

      <section>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow text-brand-600">The lineup</p>
            <h2 class="mt-1 font-display text-2xl uppercase tracking-tight text-ink sm:text-3xl">
              Top operators in {city.name}
            </h2>
          </div>
          <a
            href={`/search?q=${encodeURIComponent(`${city.name}, ${city.state}`)}`}
            class="font-mono text-xs font-semibold uppercase tracking-widest"
          >
            Full search with filters →
          </a>
        </div>
        <div class="mt-6 space-y-4">
          {
            ops.length === 0 ? (
              <div class="card p-8 text-center text-muted">
                No verified operators published for this city yet.
              </div>
            ) : (
              ops.map((op) => <OperatorCard operator={op} />)
            )
          }
        </div>
      </section>

      <section class="card p-6">
        <p class="eyebrow text-brand-600">Read next</p>
        <h2 class="mt-1 font-display text-xl uppercase tracking-tight text-ink">Related guides</h2>
        <ul class="mt-4 space-y-2.5 text-sm font-medium">
          <li><a href="/guides/dumpster-size-guide">Dumpster size guide</a></li>
          <li><a href="/guides/what-can-go-in-a-dumpster">What can go in a dumpster</a></li>
          <li><a href="/guides/dumpster-permits-overview">Permit overview</a></li>
          <li><a href="/guides/dumpster-rental-cost-factors">Cost factors</a></li>
        </ul>
      </section>
    </div>

    <aside class="space-y-4">
      <MapView markers={markers} centerLat={city.lat} centerLng={city.lng} zoom={10} heightClass="h-80" />
      <div class="card p-4 text-sm text-muted">
        Map pins use operator HQ coordinates for illustration. Confirm delivery service area with the
        operator.
      </div>
    </aside>
  </div>
</BaseLayout>
