---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ClaimListing from '../../components/ClaimListing.astro';
import { getDb } from '../../lib/db';
import { getOperatorBySlug } from '../../lib/search';
import { formatCurrency, formatDate, formatPhone } from '../../lib/geo';
import { MATERIALS, SIZE_GUIDE } from '../../lib/constants';
import { withUtm } from '../../lib/utm';
import { operatorJsonLd, pageTitle, breadcrumbJsonLd } from '../../lib/seo';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/search');

const db = getDb();
const op = await getOperatorBySlug(db, slug);
if (!op) return new Response(null, { status: 404, statusText: 'Not Found' });

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const priceLabel =
  op.pricingMin != null && op.pricingMax != null
    ? `${formatCurrency(op.pricingMin)}–${formatCurrency(op.pricingMax)}`
    : 'Request quote for pricing';

const sizes = op.sizes.map((s) => s.yards).sort((a, b) => a - b);
const materials = op.materials.map((m) => m.material);
const cities = op.serviceAreas
  .map((a) => (a.city ? `${a.city.name}, ${a.city.state}` : null))
  .filter(Boolean) as string[];

const locationLabel = op.hqCity && op.hqState ? ` in ${op.hqCity}, ${op.hqState}` : '';
const title = pageTitle([op.name, `Dumpster Rental${locationLabel}`]);
const description =
  op.description?.slice(0, 155) ||
  `${op.name} — verified dumpster rental${op.hqCity ? ` in ${op.hqCity}, ${op.hqState}` : ''}.`;

const jsonLd = [
  operatorJsonLd({
    name: op.name,
    description: op.description,
    phone: op.phone,
    website: op.website,
    hqCity: op.hqCity,
    hqState: op.hqState,
    slug: op.slug,
    siteUrl,
  }),
  breadcrumbJsonLd([
    { name: 'Home', url: siteUrl },
    { name: 'Search', url: `${siteUrl}/search` },
    { name: op.name, url: `${siteUrl}/operator/${op.slug}` },
  ]),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="border-b-2 border-charcoal-900 bg-charcoal-900 py-10 text-white">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="font-mono text-xs uppercase tracking-widest text-charcoal-400">
        <a href="/" class="text-charcoal-400 no-underline hover:text-brand-400">Home</a>
        <span class="mx-2 text-charcoal-600">/</span>
        <a href="/search" class="text-charcoal-400 no-underline hover:text-brand-400">Search</a>
        <span class="mx-2 text-charcoal-600">/</span>
        <span class="text-brand-400">{op.name}</span>
      </nav>
      <div class="mt-5 flex flex-wrap items-start justify-between gap-6">
        <div>
          <h1 class="font-display text-3xl uppercase tracking-tight sm:text-5xl">{op.name}</h1>
          <p class="mt-3 font-mono text-xs uppercase tracking-widest text-charcoal-300">
            {[op.hqCity, op.hqState].filter(Boolean).join(', ') || 'United States'}
          </p>
          <div class="mt-4">
            <VerifiedBadge
              lastVerifiedAt={op.verificationStatus === 'verified' ? op.lastVerifiedAt : null}
              isBroker={op.isBroker}
              isDemo={op.isDemo}
            />
          </div>
          {
            op.updatedAt && (
              <p class="mt-3 font-mono text-[10px] uppercase tracking-widest text-charcoal-400">
                Data updated {formatDate(op.updatedAt)}
              </p>
            )
          }
        </div>
        <div class="border-2 border-charcoal-600 bg-charcoal-800 p-4 text-right">
          <p class="font-mono text-2xl font-bold text-brand-400">{priceLabel}</p>
          <p class="mt-1 font-mono text-[10px] uppercase tracking-widest text-charcoal-400">
            Typical range · confirm all-in quote
          </p>
        </div>
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        {
          op.phone && (
            <a href={`tel:${op.phone}`} class="btn-primary">
              Call {formatPhone(op.phone)}
            </a>
          )
        }
        {
          op.website && (
            <a href={withUtm(op.website) ?? '#'} class="btn-outline-light" rel="noopener noreferrer" target="_blank">
              Website
            </a>
          )
        }
        <a href="#quote" class="btn-outline-light">Request quote</a>
      </div>
    </div>
  </div>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[1fr_360px]">
    <div class="space-y-10">
      {
        op.description && (
          <section>
            <p class="eyebrow text-brand-600">About</p>
            <h2 class="mt-1 font-display text-2xl uppercase tracking-tight text-ink">
              Meet the operator
            </h2>
            <p class="mt-3 leading-relaxed text-charcoal-700">{op.description}</p>
          </section>
        )
      }

      <section>
        <p class="eyebrow text-brand-600">Fleet</p>
        <h2 class="mt-1 font-display text-2xl uppercase tracking-tight text-ink">Sizes offered</h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {
            sizes.map((s) => (
              <li class="card flex items-start gap-4 p-4">
                <p class="font-display text-4xl text-brand-500">
                  {s}<span class="font-mono text-sm font-semibold uppercase text-muted">yd</span>
                </p>
                <p class="pt-1 text-sm text-charcoal-600">{SIZE_GUIDE[s] ?? 'Roll-off dumpster'}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <p class="eyebrow text-brand-600">Accepted loads</p>
        <h2 class="mt-1 font-display text-2xl uppercase tracking-tight text-ink">
          Materials accepted
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            materials.map((id) => {
              const label = MATERIALS.find((m) => m.id === id)?.label ?? id;
              return (
                <li class="chip border-2 border-charcoal-900 bg-white px-3 py-1.5 text-charcoal-800">
                  {label}
                </li>
              );
            })
          }
        </ul>
      </section>

      <section>
        <p class="eyebrow text-brand-600">Spec sheet</p>
        <h2 class="mt-1 font-display text-2xl uppercase tracking-tight text-ink">
          Pricing & placement
        </h2>
        <dl class="mt-5 divide-y-2 divide-charcoal-100 border-2 border-charcoal-900 bg-white shadow-[4px_4px_0_0_#121417]">
          <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
            <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
              Pricing notes
            </dt>
            <dd class="text-sm text-charcoal-800">
              {op.pricingNotes || 'Contact operator for an all-in quote including delivery and dump fees.'}
            </dd>
          </div>
          <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
            <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
              Included tonnage
            </dt>
            <dd class="font-mono text-sm font-semibold text-ink">
              {op.includedTonnage != null ? `~${op.includedTonnage} tons` : '—'}
            </dd>
          </div>
          <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
            <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
              Overage rate
            </dt>
            <dd class="font-mono text-sm font-semibold text-ink">
              {op.overageRate != null ? `~${formatCurrency(op.overageRate)}/ton` : '—'}
            </dd>
          </div>
          <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
            <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
              Driveway suitable
            </dt>
            <dd class="text-sm text-charcoal-800">
              <span class="font-mono font-semibold text-ink">
                {op.drivewaySuitable ? 'Yes' : 'Limited / ask'}
              </span>
              {op.drivewayNotes && <span class="mt-1 block text-muted">{op.drivewayNotes}</span>}
            </dd>
          </div>
          <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
            <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
              Same-day capable
            </dt>
            <dd class="font-mono text-sm font-semibold text-ink">
              {op.sameDayCapable ? 'Yes (when available)' : 'Not listed'}
            </dd>
          </div>
          <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
            <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
              Verification
            </dt>
            <dd class="text-sm text-charcoal-800">
              <span class="font-mono font-semibold uppercase text-ink">{op.verificationStatus}</span>
              {
                op.lastVerifiedAt && (
                  <span class="text-muted"> · Last verified {formatDate(op.lastVerifiedAt)}</span>
                )
              }
              {op.insuranceVerified && <span class="text-muted"> · Insurance signals reviewed</span>}
              {op.licenseNotes && <span class="mt-1 block text-muted">License notes: {op.licenseNotes}</span>}
            </dd>
          </div>
          {
            op.updatedAt && (
              <div class="grid gap-1 p-4 sm:grid-cols-[200px_1fr] sm:gap-4">
                <dt class="font-mono text-xs font-semibold uppercase tracking-wider text-muted">
                  Last updated
                </dt>
                <dd class="font-mono text-sm font-semibold text-ink">{formatDate(op.updatedAt)}</dd>
              </div>
            )
          }
        </dl>
      </section>

      {
        cities.length > 0 && (
          <section>
            <p class="eyebrow text-brand-600">Coverage</p>
            <h2 class="mt-1 font-display text-2xl uppercase tracking-tight text-ink">
              Service areas
            </h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {[...new Set(cities)].map((c) => (
                <li class="chip bg-charcoal-100 px-3 py-1.5 text-charcoal-700">{c}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="space-y-6" id="quote">
      <QuoteForm operatorId={op.id} operatorName={op.name} />
      <ClaimListing
        operatorId={op.id}
        operatorName={op.name}
        claimStatus={op.claimStatus ?? 'unclaimed'}
      />
      <div class="card p-5">
        <div class="hazard-bar -mx-5 -mt-5 mb-4 w-[calc(100%+2.5rem)]" aria-hidden="true"></div>
        <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink">
          Tips before you book
        </p>
        <ul class="mt-3 list-disc space-y-1.5 pl-4 text-sm text-charcoal-700 marker:text-brand-500">
          <li>Confirm all-in price (delivery, rental days, tonnage, overage).</li>
          <li>Ask about permit responsibility for street placement.</li>
          <li>Share driveway width and surface type for residential drops.</li>
        </ul>
        <p class="mt-4 font-mono text-xs uppercase tracking-widest">
          <a href="/guides/dumpster-size-guide">Size guide</a>
          {' · '}
          <a href="/guides/dumpster-permits-overview">Permits</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
