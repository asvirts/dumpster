---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getDb } from '../../lib/db';
import { getOperatorForOrg } from '../../lib/portal';
import { and, desc, eq, inArray } from 'drizzle-orm';
import { leads, operators } from '../../lib/schema';
import { formatDate } from '../../lib/geo';
import {
  exclusiveLeadPriceCents,
  leadPriceCents,
  priceForLead,
  unlockLeadComplimentary,
} from '../../lib/leads';
import { autoBuysThisWeek } from '../../lib/auto-unlock';
import { clampWeeklyCap, operatorNotifyEmail, parseNotifyEmail } from '../../lib/autopilot-rules';
import { logAudit } from '../../lib/admin';
import { createLeadUnlockCheckout, fulfillCheckoutSessionById } from '../../lib/lead-checkout';
import { formatUsdFromCents } from '../../lib/paid-unlock';
import { labelForContact, labelForMaterial } from '../../lib/lead-fields';

// Middleware guarantees a signed-in user with an active organization on /portal/*.
const auth = Astro.locals.auth;
const orgId = auth.organizationId!;
const userId = auth.user!.id;
const db = getDb();
const operator = await getOperatorForOrg(db, orgId);

if (Astro.request.method === 'GET' && operator) {
  const sessionId = Astro.url.searchParams.get('session_id');
  if (sessionId) {
    const result = await fulfillCheckoutSessionById(db, sessionId, operator.id);
    if (result.ok && result.pending) {
      return Astro.redirect('/portal/leads?ok=processing');
    }
    if (result.ok && !result.skipped) {
      return Astro.redirect('/portal/leads?ok=unlocked');
    }
    if (!result.ok) {
      return Astro.redirect(`/portal/leads?err=${encodeURIComponent(result.error)}`);
    }
    return Astro.redirect('/portal/leads');
  }
}

if (Astro.request.method === 'POST' && operator) {
  const form = await Astro.request.formData();
  const leadId = form.get('leadId')?.toString();
  const intent = form.get('intent')?.toString();

  if (intent === 'notify_email') {
    const parsed = parseNotifyEmail(form.get('leadNotifyEmail'));
    if (!parsed.ok) {
      return Astro.redirect('/portal/leads?err=Enter+a+valid+email+for+lead+notifications');
    }
    await db
      .update(operators)
      .set({ leadNotifyEmail: parsed.value, updatedAt: new Date().toISOString() })
      .where(eq(operators.id, operator.id));
    await logAudit(db, {
      action: 'lead_notify_email_update',
      entityType: 'operator',
      entityId: operator.id,
      actor: userId,
      notes: parsed.value ?? 'cleared (uses listing email)',
    });
    return Astro.redirect('/portal/leads?ok=notify_saved');
  }

  if (intent === 'autobuy') {
    const enable = form.get('enabled')?.toString() === '1';
    if (enable && !operator.stripePaymentMethodId) {
      return Astro.redirect('/portal/leads?err=Buy+one+lead+with+a+card+first+to+save+it+for+auto-buy');
    }
    const cap = clampWeeklyCap(form.get('cap') ?? operator.autoUnlockWeeklyCap);
    await db
      .update(operators)
      .set({
        autoUnlockEnabled: enable,
        autoUnlockWeeklyCap: cap,
        // Turning auto-buy on means they want lead emails again.
        ...(enable ? { leadEmailsOptOut: false } : {}),
        updatedAt: new Date().toISOString(),
      })
      .where(eq(operators.id, operator.id));
    await logAudit(db, {
      action: enable ? 'auto_buy_enabled' : 'auto_buy_disabled',
      entityType: 'operator',
      entityId: operator.id,
      actor: userId,
      notes: `weekly cap ${cap}`,
    });
    return Astro.redirect(`/portal/leads?ok=${enable ? 'autobuy_on' : 'autobuy_off'}`);
  }

  if (leadId && intent === 'complimentary') {
    const result = await unlockLeadComplimentary(db, {
      leadId,
      operatorId: operator.id,
      actor: userId,
    });
    if (!result.ok) {
      return Astro.redirect(`/portal/leads?err=${encodeURIComponent(result.error)}`);
    }
    return Astro.redirect('/portal/leads?ok=unlocked');
  }

  if (leadId && intent === 'checkout') {
    const lead = await db.query.leads.findFirst({ where: eq(leads.id, leadId) });
    if (!lead || lead.operatorId !== operator.id || lead.status !== 'offered') {
      return Astro.redirect('/portal/leads?err=Lead+not+available');
    }
    try {
      const checkout = await createLeadUnlockCheckout(db, {
        lead,
        operator,
        orgId,
      });
      if (!checkout.ok) {
        return Astro.redirect(`/portal/leads?err=${encodeURIComponent(checkout.error)}`);
      }
      return Astro.redirect(checkout.url);
    } catch (err) {
      console.error('[portal] checkout', err);
      return Astro.redirect('/portal/leads?err=Checkout+unavailable');
    }
  }
}

const rows = operator
  ? await db
      .select()
      .from(leads)
      .where(
        and(
          eq(leads.operatorId, operator.id),
          inArray(leads.status, ['offered', 'unlocked', 'closed']),
        ),
      )
      .orderBy(desc(leads.createdAt))
      .limit(100)
  : [];

const defaultPriceLabel = formatUsdFromCents(leadPriceCents());
const exclusivePriceLabel = formatUsdFromCents(exclusiveLeadPriceCents());
const autoBoughtThisWeek = operator ? await autoBuysThisWeek(db, operator.id) : 0;
const notifyEmail = operator ? operatorNotifyEmail(operator) : null;
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const canceled = Astro.url.searchParams.get('canceled');
---

<PortalLayout title="Leads">
  {
    !operator ? (
      <p class="card p-6 text-sm text-muted">
        Claim and get approval for a listing before unlocking leads.
        <a href="/portal">Back to overview</a>
      </p>
    ) : (
      <>
        <p class="mb-4 text-sm text-muted">
          Offered leads hide contact details until unlocked. You have{' '}
          <strong>{operator.complimentaryLeadsRemaining}</strong> complimentary unlock
          {operator.complimentaryLeadsRemaining === 1 ? '' : 's'} left; after that unlocks cost
          the price shown on each lead: {exclusivePriceLabel} when the customer asked for you
          directly (exclusive), {defaultPriceLabel} when shared with up to 2 other operators.
        </p>
        <section class="card mb-6 p-5" aria-labelledby="notify-heading">
          <h2 id="notify-heading" class="font-bold text-ink">Lead emails</h2>
          <p class="mt-1 text-sm text-muted">
            {operator.leadEmailsOptOut
              ? 'You unsubscribed from lead emails, so no new leads are offered to you. Turn on auto-buy to start again.'
              : notifyEmail
                ? <>New leads, unlocks and receipts go to <strong>{notifyEmail}</strong>.</>
                : 'No email on file: new leads only show up on this page. Add an address to be told when one arrives.'}
          </p>
          <form method="POST" class="mt-4 flex flex-wrap items-end gap-3">
            <input type="hidden" name="intent" value="notify_email" />
            <div class="min-w-0 flex-1 sm:max-w-sm">
              <label class="label" for="lead-notify-email">Send lead emails to</label>
              <input
                class="input"
                id="lead-notify-email"
                name="leadNotifyEmail"
                type="email"
                value={operator.leadNotifyEmail ?? ''}
                placeholder={operator.email ?? 'you@company.com'}
              />
            </div>
            <button type="submit" class="btn-secondary text-xs">Save</button>
            <p class="w-full text-xs text-muted">
              Leave blank to use your listing's public email{operator.email ? ` (${operator.email})` : ''}.
            </p>
          </form>
        </section>
        <section class="card mb-6 p-5" aria-labelledby="autobuy-heading">
          <h2 id="autobuy-heading" class="font-bold text-ink">Auto-buy</h2>
          <p class="mt-1 text-sm text-muted">
            Get new leads with full contact details the moment they come in. We charge your saved
            card the price shown on each lead, up to your weekly limit. Turn it off any time.
          </p>
          {operator.stripePaymentMethodId ? (
            <form method="POST" class="mt-4 flex flex-wrap items-end gap-3">
              <input type="hidden" name="intent" value="autobuy" />
              <div>
                <label class="label" for="autobuy-cap">Max leads per week</label>
                <input
                  class="input w-28"
                  id="autobuy-cap"
                  name="cap"
                  type="number"
                  min="1"
                  max="100"
                  value={operator.autoUnlockWeeklyCap}
                />
              </div>
              {operator.autoUnlockEnabled ? (
                <>
                  <button type="submit" name="enabled" value="1" class="btn-secondary text-xs">
                    Save limit
                  </button>
                  <button type="submit" name="enabled" value="0" class="btn-secondary text-xs">
                    Turn off auto-buy
                  </button>
                </>
              ) : (
                <button type="submit" name="enabled" value="1" class="btn-primary text-xs">
                  Turn on auto-buy
                </button>
              )}
              <p class="w-full text-xs text-muted">
                {operator.autoUnlockEnabled ? 'On' : 'Off'} · card {operator.stripePaymentMethodLabel ?? 'on file'} ·{' '}
                {autoBoughtThisWeek} bought in the last 7 days
              </p>
            </form>
          ) : (
            <p class="mt-3 text-sm text-muted">
              Buy one lead with a card below and it is saved for auto-buy.
            </p>
          )}
        </section>
        {ok === 'unlocked' && (
          <p class="mb-4 border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
            Lead unlocked.
          </p>
        )}
        {ok === 'autobuy_on' && (
          <p class="mb-4 border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
            Auto-buy is on. New leads will arrive unlocked.
          </p>
        )}
        {ok === 'notify_saved' && (
          <p class="mb-4 border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
            Lead email address saved.
          </p>
        )}
        {ok === 'autobuy_off' && (
          <p class="mb-4 border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
            Auto-buy is off.
          </p>
        )}
        {ok === 'processing' && (
          <p class="mb-4 border-2 border-amber-500 bg-amber-50 px-3 py-2 text-sm">
            Payment received. Contact details appear once the payment fully clears.
          </p>
        )}
        {canceled && (
          <p class="mb-4 border-2 border-amber-500 bg-amber-50 px-3 py-2 text-sm">Checkout canceled.</p>
        )}
        {err && (
          <p class="mb-4 border-2 border-red-600 bg-red-50 px-3 py-2 text-sm text-red-800">{err}</p>
        )}
        <div class="space-y-4">
          {rows.length === 0 ? (
            <p class="card p-8 text-center text-sm text-muted">No leads assigned yet.</p>
          ) : (
            rows.map((lead) => (
              <article class="card p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h2 class="font-bold text-ink">
                      {lead.status === 'unlocked' ? lead.seekerName : 'Lead available'}
                    </h2>
                    {lead.status === 'unlocked' ? (
                      <p class="text-sm text-muted">
                        {lead.seekerEmail}
                        {lead.seekerPhone && <> · {lead.seekerPhone}</>}
                      </p>
                    ) : lead.status === 'offered' ? (
                      <p class="text-sm text-muted">
                        Contact details unlock after complimentary or paid unlock.
                      </p>
                    ) : (
                      <p class="text-sm text-muted">Status: {lead.status}</p>
                    )}
                  </div>
                  <div class="text-right text-xs text-muted">
                    <p>{formatDate(lead.createdAt)}</p>
                    <p class="mt-1 font-semibold uppercase text-ink">{lead.status}</p>
                  </div>
                </div>
                <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
                  <div>
                    <dt class="text-muted">Size</dt>
                    <dd>{lead.projectSize || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Material</dt>
                    <dd>{labelForMaterial(lead.material)}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Location</dt>
                    <dd>{lead.addressOrZip || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Timeline</dt>
                    <dd>{lead.timeline || '—'}</dd>
                  </div>
                  {lead.status === 'unlocked' && (
                    <div>
                      <dt class="text-muted">Preferred contact</dt>
                      <dd>{labelForContact(lead.preferredContact)}</dd>
                    </div>
                  )}
                  {lead.status === 'unlocked' && lead.notes && (
                    <div class="sm:col-span-2">
                      <dt class="text-muted">Notes</dt>
                      <dd>{lead.notes}</dd>
                    </div>
                  )}
                </dl>
                {lead.status === 'offered' && (
                  <form method="POST" class="mt-4 flex flex-wrap gap-2">
                    <input type="hidden" name="leadId" value={lead.id} />
                    {operator.complimentaryLeadsRemaining > 0 ? (
                      <button type="submit" name="intent" value="complimentary" class="btn-primary text-xs">
                        Unlock free teaser
                      </button>
                    ) : (
                      <button type="submit" name="intent" value="checkout" class="btn-primary text-xs">
                        Unlock for {formatUsdFromCents(priceForLead(lead))}
                      </button>
                    )}
                  </form>
                )}
              </article>
            ))
          )}
        </div>
      </>
    )
  }
</PortalLayout>
