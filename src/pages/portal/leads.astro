---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getDb } from '../../lib/db';
import { getOperatorForOrg } from '../../lib/portal';
import { and, desc, eq, inArray } from 'drizzle-orm';
import { leads } from '../../lib/schema';
import { formatDate } from '../../lib/geo';
import { leadPriceCents, priceForLead, unlockLeadComplimentary } from '../../lib/leads';
import { createLeadUnlockCheckout, fulfillCheckoutSessionById } from '../../lib/lead-checkout';
import { formatUsdFromCents } from '../../lib/paid-unlock';
import { labelForContact, labelForMaterial } from '../../lib/lead-fields';

const auth = Astro.locals.auth();
const orgId = auth.orgId!;
const userId = auth.userId!;
const db = getDb();
const operator = await getOperatorForOrg(db, orgId);

if (Astro.request.method === 'GET' && operator) {
  const sessionId = Astro.url.searchParams.get('session_id');
  if (sessionId) {
    const result = await fulfillCheckoutSessionById(db, sessionId, operator.id);
    if (result.ok && result.pending) {
      return Astro.redirect('/portal/leads?ok=processing');
    }
    if (result.ok && !result.skipped) {
      return Astro.redirect('/portal/leads?ok=unlocked');
    }
    if (!result.ok) {
      return Astro.redirect(`/portal/leads?err=${encodeURIComponent(result.error)}`);
    }
    return Astro.redirect('/portal/leads');
  }
}

if (Astro.request.method === 'POST' && operator) {
  const form = await Astro.request.formData();
  const leadId = form.get('leadId')?.toString();
  const intent = form.get('intent')?.toString();

  if (leadId && intent === 'complimentary') {
    const result = await unlockLeadComplimentary(db, {
      leadId,
      operatorId: operator.id,
      actor: userId,
    });
    if (!result.ok) {
      return Astro.redirect(`/portal/leads?err=${encodeURIComponent(result.error)}`);
    }
    return Astro.redirect('/portal/leads?ok=unlocked');
  }

  if (leadId && intent === 'checkout') {
    const lead = await db.query.leads.findFirst({ where: eq(leads.id, leadId) });
    if (!lead || lead.operatorId !== operator.id || lead.status !== 'offered') {
      return Astro.redirect('/portal/leads?err=Lead+not+available');
    }
    try {
      const checkout = await createLeadUnlockCheckout(db, {
        lead,
        operator,
        clerkOrgId: orgId,
      });
      if (!checkout.ok) {
        return Astro.redirect(`/portal/leads?err=${encodeURIComponent(checkout.error)}`);
      }
      return Astro.redirect(checkout.url);
    } catch (err) {
      console.error('[portal] checkout', err);
      return Astro.redirect('/portal/leads?err=Checkout+unavailable');
    }
  }
}

const rows = operator
  ? await db
      .select()
      .from(leads)
      .where(
        and(
          eq(leads.operatorId, operator.id),
          inArray(leads.status, ['offered', 'unlocked', 'closed']),
        ),
      )
      .orderBy(desc(leads.createdAt))
      .limit(100)
  : [];

const defaultPriceLabel = formatUsdFromCents(leadPriceCents());
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const canceled = Astro.url.searchParams.get('canceled');
---

<PortalLayout title="Leads">
  {
    !operator ? (
      <p class="card p-6 text-sm text-muted">
        Claim and get approval for a listing before unlocking leads.
        <a href="/portal">Back to overview</a>
      </p>
    ) : (
      <>
        <p class="mb-4 text-sm text-muted">
          Offered leads hide contact details until unlocked. You have{' '}
          <strong>{operator.complimentaryLeadsRemaining}</strong> complimentary unlock
          {operator.complimentaryLeadsRemaining === 1 ? '' : 's'} left; after that unlocks cost
          the price shown on each lead (default {defaultPriceLabel}).
        </p>
        {ok === 'unlocked' && (
          <p class="mb-4 border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
            Lead unlocked.
          </p>
        )}
        {ok === 'processing' && (
          <p class="mb-4 border-2 border-amber-500 bg-amber-50 px-3 py-2 text-sm">
            Payment received. Contact details appear once the payment fully clears.
          </p>
        )}
        {canceled && (
          <p class="mb-4 border-2 border-amber-500 bg-amber-50 px-3 py-2 text-sm">Checkout canceled.</p>
        )}
        {err && (
          <p class="mb-4 border-2 border-red-600 bg-red-50 px-3 py-2 text-sm text-red-800">{err}</p>
        )}
        <div class="space-y-4">
          {rows.length === 0 ? (
            <p class="card p-8 text-center text-sm text-muted">No leads assigned yet.</p>
          ) : (
            rows.map((lead) => (
              <article class="card p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h2 class="font-bold text-ink">
                      {lead.status === 'unlocked' ? lead.seekerName : 'Lead available'}
                    </h2>
                    {lead.status === 'unlocked' ? (
                      <p class="text-sm text-muted">
                        {lead.seekerEmail}
                        {lead.seekerPhone && <> · {lead.seekerPhone}</>}
                      </p>
                    ) : lead.status === 'offered' ? (
                      <p class="text-sm text-muted">
                        Contact details unlock after complimentary or paid unlock.
                      </p>
                    ) : (
                      <p class="text-sm text-muted">Status: {lead.status}</p>
                    )}
                  </div>
                  <div class="text-right text-xs text-muted">
                    <p>{formatDate(lead.createdAt)}</p>
                    <p class="mt-1 font-semibold uppercase text-ink">{lead.status}</p>
                  </div>
                </div>
                <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
                  <div>
                    <dt class="text-muted">Size</dt>
                    <dd>{lead.projectSize || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Material</dt>
                    <dd>{labelForMaterial(lead.material)}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Location</dt>
                    <dd>{lead.addressOrZip || '—'}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Timeline</dt>
                    <dd>{lead.timeline || '—'}</dd>
                  </div>
                  {lead.status === 'unlocked' && (
                    <div>
                      <dt class="text-muted">Preferred contact</dt>
                      <dd>{labelForContact(lead.preferredContact)}</dd>
                    </div>
                  )}
                  {lead.status === 'unlocked' && lead.notes && (
                    <div class="sm:col-span-2">
                      <dt class="text-muted">Notes</dt>
                      <dd>{lead.notes}</dd>
                    </div>
                  )}
                </dl>
                {lead.status === 'offered' && (
                  <form method="POST" class="mt-4 flex flex-wrap gap-2">
                    <input type="hidden" name="leadId" value={lead.id} />
                    {operator.complimentaryLeadsRemaining > 0 ? (
                      <button type="submit" name="intent" value="complimentary" class="btn-primary text-xs">
                        Unlock free teaser
                      </button>
                    ) : (
                      <button type="submit" name="intent" value="checkout" class="btn-primary text-xs">
                        Unlock for {formatUsdFromCents(priceForLead(lead))}
                      </button>
                    )}
                  </form>
                )}
              </article>
            ))
          )}
        </div>
      </>
    )
  }
</PortalLayout>
