---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { safeReturnTo, switchOrganization, workos } from '../../lib/auth';

// Operator accounts are companies = WorkOS organizations. The chosen one becomes the
// session's active organization (auth.orgId), which the portal and claims key off.
const auth = Astro.locals.auth!;
const returnTo = safeReturnTo(Astro.url.searchParams.get('returnTo'), '/portal');
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = form.get('intent');
  try {
    let organizationId = form.get('organizationId')?.toString() ?? '';
    if (intent === 'create') {
      const name = form.get('name')?.toString().trim() ?? '';
      if (name.length < 2 || name.length > 120) {
        throw new Error('Enter a company name (2–120 characters).');
      }
      const org = await workos().organizations.createOrganization({ name });
      await workos().userManagement.createOrganizationMembership({
        organizationId: org.id,
        userId: auth.userId,
      });
      organizationId = org.id;
    }
    if (!organizationId) throw new Error('Choose a company.');
    if (!(await switchOrganization(Astro.cookies, Astro.url, organizationId))) {
      throw new Error('Could not switch to that company. Try signing in again.');
    }
    return Astro.redirect(returnTo);
  } catch (err) {
    console.error('[portal] select-org', err);
    error = err instanceof Error ? err.message : 'Something went wrong.';
  }
}

const memberships = await workos().userManagement.listOrganizationMemberships({
  userId: auth.userId,
  statuses: ['active'],
  limit: 100,
});
const orgs = memberships.data.map((m) => ({
  id: m.organizationId,
  name: m.organizationName ?? m.organizationId,
}));
---

<PortalLayout title="Select company">
  <p class="mb-6 text-sm text-muted">
    Operator accounts belong to a company. Choose one of yours or create it to continue.
  </p>
  {
    error && (
      <p class="mb-6 border-2 border-red-600 bg-red-50 px-3 py-2 text-sm text-red-800">{error}</p>
    )
  }
  <div class="grid gap-8 lg:grid-cols-2">
    <div class="card p-5">
      <h2 class="mb-4 font-bold text-ink">Your companies</h2>
      {
        orgs.length === 0 ? (
          <p class="text-sm text-muted">You don’t belong to a company yet.</p>
        ) : (
          <ul class="space-y-2">
            {orgs.map((org) => (
              <li>
                <form method="POST" class="flex items-center justify-between gap-3">
                  <input type="hidden" name="intent" value="select" />
                  <input type="hidden" name="organizationId" value={org.id} />
                  <span class="text-sm font-medium text-ink">
                    {org.name}
                    {org.id === auth.orgId && <span class="ml-2 text-xs text-muted">(current)</span>}
                  </span>
                  <button type="submit" class="btn-secondary px-3 py-1.5 text-xs">
                    Use
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="card p-5">
      <h2 class="mb-4 font-bold text-ink">Create company</h2>
      <form method="POST" class="space-y-3">
        <input type="hidden" name="intent" value="create" />
        <div>
          <label class="label" for="org-name">Company name</label>
          <input class="input" id="org-name" name="name" required minlength="2" maxlength="120" />
        </div>
        <button type="submit" class="btn-primary text-xs">Create and continue</button>
      </form>
    </div>
  </div>
</PortalLayout>
