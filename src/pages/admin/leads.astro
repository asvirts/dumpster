---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { and, desc, eq, gte, like, lte, or } from 'drizzle-orm';
import { alias } from 'drizzle-orm/sqlite-core';
import { leads, operators } from '../../lib/schema';
import { formatDate } from '../../lib/geo';
import { LEAD_MODES, LEAD_STATUSES, type LeadStatus } from '../../lib/constants';
import { logAudit } from '../../lib/admin';
import { csvEscape, routeLeadToOperator } from '../../lib/leads';
import { labelForMaterial } from '../../lib/lead-fields';

const db = getDb();
const actor = Astro.locals.adminEmail ?? 'admin';
const requested = alias(operators, 'requested_op');
const assigned = alias(operators, 'assigned_op');

const statusFilter = Astro.url.searchParams.get('status') ?? '';
const modeFilter = Astro.url.searchParams.get('mode') ?? '';
const operatorFilter = Astro.url.searchParams.get('operator') ?? '';
const q = Astro.url.searchParams.get('q') ?? '';
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = form.get('id')?.toString();
  const intent = form.get('intent')?.toString();
  const operatorId = form.get('operatorId')?.toString();
  let flash: string | null = null;
  let flashError: string | null = null;

  if (id && intent === 'close') {
    await db.update(leads).set({ status: 'closed' }).where(eq(leads.id, id));
    await logAudit(db, { action: 'lead_close', entityType: 'lead', entityId: id, actor });
    flash = 'Lead closed.';
  } else if (id && (intent === 'spam' || intent === 'invalid')) {
    await db.update(leads).set({ status: intent }).where(eq(leads.id, id));
    await logAudit(db, { action: `lead_${intent}`, entityType: 'lead', entityId: id, actor });
    flash = `Lead marked ${intent}.`;
  } else if (id && intent === 'pass_complimentary' && operatorId) {
    const result = await routeLeadToOperator(db, {
      leadId: id,
      operatorId,
      action: 'complimentary',
      actor,
    });
    if (result.ok) flash = 'Lead unlocked complimentary and emailed.';
    else flashError = result.error;
  } else if (id && intent === 'offer_paid' && operatorId) {
    const result = await routeLeadToOperator(db, {
      leadId: id,
      operatorId,
      action: 'offer',
      actor,
    });
    if (result.ok) flash = 'Lead offered (paid unlock).';
    else flashError = result.error;
  } else if (id && intent === 'reassign' && operatorId) {
    await db.update(leads).set({ operatorId }).where(eq(leads.id, id));
    await logAudit(db, {
      action: 'lead_reassign',
      entityType: 'lead',
      entityId: id,
      actor,
      notes: `Assigned to ${operatorId}`,
    });
    flash = 'Lead reassigned.';
  } else if (id && intent === 'status') {
    const status = form.get('status')?.toString() as LeadStatus | undefined;
    if (status && (LEAD_STATUSES as readonly string[]).includes(status)) {
      await db.update(leads).set({ status }).where(eq(leads.id, id));
      flash = 'Status updated.';
    }
  }

  const params = new URLSearchParams();
  if (flash) params.set('ok', flash);
  if (flashError) params.set('err', flashError);
  for (const [k, v] of [
    ['status', statusFilter],
    ['mode', modeFilter],
    ['operator', operatorFilter],
    ['q', q],
    ['from', from],
    ['to', to],
  ]) {
    if (v) params.set(k, v);
  }
  return Astro.redirect(`/admin/leads?${params.toString()}`);
}

const conditions = [];
if (statusFilter && (LEAD_STATUSES as readonly string[]).includes(statusFilter)) {
  conditions.push(eq(leads.status, statusFilter as LeadStatus));
}
if (modeFilter && (LEAD_MODES as readonly string[]).includes(modeFilter as (typeof LEAD_MODES)[number])) {
  conditions.push(eq(leads.mode, modeFilter as (typeof LEAD_MODES)[number]));
}
if (operatorFilter) {
  conditions.push(
    or(eq(leads.operatorId, operatorFilter), eq(leads.requestedOperatorId, operatorFilter)),
  );
}
if (q.trim()) {
  const likeQ = `%${q.trim()}%`;
  conditions.push(
    or(
      like(leads.seekerName, likeQ),
      like(leads.seekerEmail, likeQ),
      like(leads.seekerPhone, likeQ),
      like(leads.addressOrZip, likeQ),
    ),
  );
}
if (from) conditions.push(gte(leads.createdAt, `${from}T00:00:00.000Z`));
if (to) conditions.push(lte(leads.createdAt, `${to}T23:59:59.999Z`));

const where = conditions.length ? and(...conditions) : undefined;

const baseSelect = db
  .select({
    lead: leads,
    operatorName: assigned.name,
    operatorSlug: assigned.slug,
    complimentaryRemaining: assigned.complimentaryLeadsRemaining,
    claimStatus: assigned.claimStatus,
    requestedName: requested.name,
    requestedSlug: requested.slug,
  })
  .from(leads)
  .leftJoin(assigned, eq(leads.operatorId, assigned.id))
  .leftJoin(requested, eq(leads.requestedOperatorId, requested.id));

const rows = await (where ? baseSelect.where(where) : baseSelect)
  .orderBy(desc(leads.createdAt))
  .limit(200);

if (Astro.url.searchParams.get('export') === 'csv') {
  const header = [
    'id',
    'createdAt',
    'status',
    'mode',
    'seekerName',
    'seekerEmail',
    'seekerPhone',
    'preferredContact',
    'addressOrZip',
    'projectSize',
    'material',
    'timeline',
    'budgetRange',
    'howFound',
    'notes',
    'assignedOperator',
    'requestedOperator',
    'sourcePath',
    'utmSource',
    'utmMedium',
    'utmCampaign',
    'groupId',
    'unlockMethod',
    'priceCents',
  ];
  const lines = [
    header.join(','),
    ...rows.map(({ lead, operatorName, requestedName }) =>
      [
        lead.id,
        lead.createdAt,
        lead.status,
        lead.mode,
        lead.seekerName,
        lead.seekerEmail,
        lead.seekerPhone,
        lead.preferredContact,
        lead.addressOrZip,
        lead.projectSize,
        lead.material,
        lead.timeline,
        lead.budgetRange,
        lead.howFound,
        lead.notes,
        operatorName,
        requestedName,
        lead.sourcePath,
        lead.utmSource,
        lead.utmMedium,
        lead.utmCampaign,
        lead.groupId,
        lead.unlockMethod,
        lead.priceCents,
      ]
        .map(csvEscape)
        .join(','),
    ),
  ];
  return new Response(lines.join('\n'), {
    headers: {
      'Content-Type': 'text/csv; charset=utf-8',
      'Content-Disposition': 'attachment; filename="leads.csv"',
    },
  });
}

const operatorOptions = await db
  .select({
    id: operators.id,
    name: operators.name,
    complimentaryLeadsRemaining: operators.complimentaryLeadsRemaining,
    claimStatus: operators.claimStatus,
  })
  .from(operators)
  .orderBy(operators.name)
  .limit(500);

const okMsg = Astro.url.searchParams.get('ok');
const errMsg = Astro.url.searchParams.get('err');
const exportQs = new URLSearchParams(Astro.url.searchParams);
exportQs.set('export', 'csv');
---

<AdminLayout title="Leads">
  <p class="mb-4 text-sm text-muted">
    Quotes stay held until you route them. First unlock per operator can be complimentary; after that
    offer paid unlock. Match requests can go to up to 3 operators.
  </p>

  {
    okMsg && (
      <p class="mb-4 border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800" role="status">
        {okMsg}
      </p>
    )
  }
  {
    errMsg && (
      <p class="mb-4 border-2 border-red-600 bg-red-50 px-3 py-2 text-sm text-red-800" role="alert">
        {errMsg}
      </p>
    )
  }

  <form method="GET" class="mb-6 flex flex-wrap items-end gap-3">
    <div>
      <label class="label" for="q">Search</label>
      <input class="input w-48" id="q" name="q" value={q} placeholder="Name, email, ZIP" />
    </div>
    <div>
      <label class="label" for="status">Status</label>
      <select class="input w-36" id="status" name="status">
        <option value="">All</option>
        {LEAD_STATUSES.map((s) => (
          <option value={s} selected={statusFilter === s}>
            {s}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label class="label" for="mode">Mode</label>
      <select class="input w-32" id="mode" name="mode">
        <option value="">All</option>
        {LEAD_MODES.map((m) => (
          <option value={m} selected={modeFilter === m}>
            {m}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label class="label" for="operator">Operator</label>
      <select class="input min-w-[12rem]" id="operator" name="operator">
        <option value="">All</option>
        {operatorOptions.map((op) => (
          <option value={op.id} selected={operatorFilter === op.id}>
            {op.name}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label class="label" for="from">From</label>
      <input class="input" id="from" name="from" type="date" value={from} />
    </div>
    <div>
      <label class="label" for="to">To</label>
      <input class="input" id="to" name="to" type="date" value={to} />
    </div>
    <button type="submit" class="btn-secondary text-xs">Filter</button>
    <a href={`/admin/leads?${exportQs.toString()}`} class="btn-ghost text-xs">Export CSV</a>
  </form>

  <div class="space-y-4">
    {
      rows.length === 0 ? (
        <p class="card p-8 text-center text-sm text-muted">No leads match these filters.</p>
      ) : (
        rows.map(
          ({
            lead,
            operatorName,
            operatorSlug,
            complimentaryRemaining,
            claimStatus,
            requestedName,
            requestedSlug,
          }) => (
            <article class="card p-5">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h2 class="font-bold text-ink">
                    <a href={`/admin/leads/${lead.id}`}>{lead.seekerName}</a>
                  </h2>
                  <p class="text-sm text-muted">
                    {lead.seekerEmail}
                    {lead.seekerPhone && <> · {lead.seekerPhone}</>}
                  </p>
                  <p class="mt-1 text-sm">
                    <span class="font-mono text-xs uppercase text-muted">{lead.mode}</span>
                    {' · '}
                    Assigned:{' '}
                    {operatorSlug ? (
                      <a href={`/operator/${operatorSlug}`}>{operatorName}</a>
                    ) : (
                      operatorName || (lead.operatorId ?? 'unassigned')
                    )}
                    {typeof complimentaryRemaining === 'number' && (
                      <span class="text-muted"> · free left: {complimentaryRemaining}</span>
                    )}
                    {claimStatus && <span class="text-muted"> · claim: {claimStatus}</span>}
                  </p>
                  {(requestedName || requestedSlug) &&
                    lead.requestedOperatorId !== lead.operatorId && (
                      <p class="text-sm text-muted">
                        Originally requested:{' '}
                        {requestedSlug ? (
                          <a href={`/operator/${requestedSlug}`}>{requestedName}</a>
                        ) : (
                          requestedName
                        )}
                      </p>
                    )}
                  {lead.sourcePath && (
                    <p class="mt-1 font-mono text-[11px] text-muted">{lead.sourcePath}</p>
                  )}
                </div>
                <div class="text-right text-xs text-muted">
                  <p>{formatDate(lead.createdAt)}</p>
                  <p class="mt-1 font-semibold uppercase text-ink">{lead.status}</p>
                  {lead.unlockMethod && (
                    <p class="mt-0.5 uppercase text-brand-700">{lead.unlockMethod}</p>
                  )}
                </div>
              </div>
              <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-muted">Size</dt>
                  <dd>{lead.projectSize || '—'}</dd>
                </div>
                <div>
                  <dt class="text-muted">Material</dt>
                  <dd>{labelForMaterial(lead.material)}</dd>
                </div>
                <div>
                  <dt class="text-muted">Location</dt>
                  <dd>{lead.addressOrZip || '—'}</dd>
                </div>
                <div>
                  <dt class="text-muted">Timeline</dt>
                  <dd>{lead.timeline || '—'}</dd>
                </div>
                {lead.notes && (
                  <div class="sm:col-span-2">
                    <dt class="text-muted">Notes</dt>
                    <dd>{lead.notes}</dd>
                  </div>
                )}
              </dl>

              {lead.status !== 'unlocked' &&
                lead.status !== 'closed' &&
                lead.status !== 'spam' &&
                lead.status !== 'invalid' && (
                  <form method="POST" class="mt-4 flex flex-wrap items-end gap-2 border-t border-border pt-4">
                    <input type="hidden" name="id" value={lead.id} />
                    <div>
                      <label class="label" for={`op-${lead.id}`}>
                        Operator
                      </label>
                      <select class="input min-w-[14rem]" id={`op-${lead.id}`} name="operatorId" required>
                        {operatorOptions.map((op) => (
                          <option value={op.id} selected={op.id === lead.operatorId}>
                            {op.name} (free:{op.complimentaryLeadsRemaining} · {op.claimStatus})
                          </option>
                        ))}
                      </select>
                    </div>
                    <button
                      type="submit"
                      name="intent"
                      value="pass_complimentary"
                      class="btn-primary text-xs"
                    >
                      Pass complimentary
                    </button>
                    <button type="submit" name="intent" value="offer_paid" class="btn-secondary text-xs">
                      Offer paid
                    </button>
                    <button type="submit" name="intent" value="reassign" class="btn-ghost text-xs">
                      Reassign only
                    </button>
                    <button type="submit" name="intent" value="close" class="btn-ghost text-xs">
                      Close
                    </button>
                    <button type="submit" name="intent" value="spam" class="btn-ghost text-xs text-red-700">
                      Spam
                    </button>
                    <button type="submit" name="intent" value="invalid" class="btn-ghost text-xs">
                      Invalid
                    </button>
                  </form>
                )}

              <p class="mt-3 text-xs">
                <a href={`/admin/leads/${lead.id}`}>Open details →</a>
              </p>
            </article>
          ),
        )
      )
    }
  </div>
</AdminLayout>
