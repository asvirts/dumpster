---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { desc, eq } from 'drizzle-orm';
import { leads, operators } from '../../lib/schema';
import { formatDate } from '../../lib/geo';

const db = getDb();

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = form.get('id')?.toString();
  const status = form.get('status')?.toString();
  if (id && (status === 'new' || status === 'notified' || status === 'closed')) {
    await db.update(leads).set({ status }).where(eq(leads.id, id));
  }
  return Astro.redirect('/admin/leads');
}

const rows = await db
  .select({
    lead: leads,
    operatorName: operators.name,
    operatorSlug: operators.slug,
  })
  .from(leads)
  .leftJoin(operators, eq(leads.operatorId, operators.id))
  .orderBy(desc(leads.createdAt))
  .limit(200);
---

<AdminLayout title="Leads">
  <p class="mb-6 text-sm text-muted">Quote requests from the public site. Email delivery is best-effort.</p>
  <div class="space-y-4">
    {
      rows.length === 0 ? (
        <p class="card p-8 text-center text-sm text-muted">No leads yet.</p>
      ) : (
        rows.map(({ lead, operatorName, operatorSlug }) => (
          <article class="card p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="font-bold text-ink">{lead.seekerName}</h2>
                <p class="text-sm text-muted">
                  {lead.seekerEmail}
                  {lead.seekerPhone && <> · {lead.seekerPhone}</>}
                </p>
                <p class="mt-1 text-sm">
                  Operator:{' '}
                  {operatorSlug ? (
                    <a href={`/operator/${operatorSlug}`}>{operatorName}</a>
                  ) : (
                    operatorName || lead.operatorId
                  )}
                </p>
              </div>
              <div class="text-right text-xs text-muted">
                <p>{formatDate(lead.createdAt)}</p>
                <p class="mt-1 font-semibold uppercase text-ink">{lead.status}</p>
              </div>
            </div>
            <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
              <div>
                <dt class="text-muted">Size</dt>
                <dd>{lead.projectSize || '—'}</dd>
              </div>
              <div>
                <dt class="text-muted">Material</dt>
                <dd>{lead.material || '—'}</dd>
              </div>
              <div>
                <dt class="text-muted">Location</dt>
                <dd>{lead.addressOrZip || '—'}</dd>
              </div>
              <div>
                <dt class="text-muted">Timeline</dt>
                <dd>{lead.timeline || '—'}</dd>
              </div>
              {lead.notes && (
                <div class="sm:col-span-2">
                  <dt class="text-muted">Notes</dt>
                  <dd>{lead.notes}</dd>
                </div>
              )}
            </dl>
            <form method="POST" class="mt-4 flex flex-wrap gap-2">
              <input type="hidden" name="id" value={lead.id} />
              <select class="input w-36" name="status">
                <option value="new" selected={lead.status === 'new'}>
                  new
                </option>
                <option value="notified" selected={lead.status === 'notified'}>
                  notified
                </option>
                <option value="closed" selected={lead.status === 'closed'}>
                  closed
                </option>
              </select>
              <button type="submit" class="btn-secondary text-xs">
                Update status
              </button>
            </form>
          </article>
        ))
      )
    }
  </div>
</AdminLayout>
