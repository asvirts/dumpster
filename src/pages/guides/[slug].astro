---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({
    params: { slug: g.id },
    props: { guide: g },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// Guides are static content
export const prerender = true;
---

<BaseLayout
  title={pageTitle(guide.data.title)}
  description={guide.data.description}
>
  <article class="container-page py-12">
    <p class="text-sm text-muted">
      <a href="/guides" class="text-muted no-underline hover:text-brand-700">Guides</a>
      <span class="mx-2">/</span>
      {guide.data.title}
    </p>
    <h1 class="mt-4 text-3xl font-extrabold text-ink sm:text-4xl">{guide.data.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">{guide.data.description}</p>
    <div class="prose-guide mt-10">
      <Content />
    </div>
    <div class="mt-12 card bg-brand-50 p-6">
      <p class="font-semibold text-brand-900">Ready to find a local operator?</p>
      <p class="mt-1 text-sm text-brand-800">Search verified dumpster rentals by city or ZIP.</p>
      <a href="/search" class="btn-primary mt-4 inline-flex">Search operators</a>
    </div>
  </article>
</BaseLayout>
