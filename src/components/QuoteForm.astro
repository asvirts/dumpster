---
import { DUMPSTER_SIZES, MATERIALS } from '../lib/constants';
import { actions } from 'astro:actions';

interface Props {
  operatorId: string;
  operatorName: string;
  defaultSize?: string;
  defaultZip?: string;
}

const { operatorId, operatorName, defaultSize = '', defaultZip = '' } = Astro.props;
const result = Astro.getActionResult(actions.submitQuote);
---

{
  result?.data?.ok ? (
    <div class="card border-green-600 bg-green-50 p-6" role="status">
      <p class="font-mono text-xs font-bold uppercase tracking-widest text-green-700">
        Request sent
      </p>
      <h3 class="mt-2 font-display text-xl uppercase tracking-tight text-ink">You're on the books</h3>
      <p class="mt-2 text-sm text-charcoal-700">
        Thanks — your quote request for <strong>{operatorName}</strong> was submitted. Our team will review
        it and connect you with a local operator using the contact details you provided.
      </p>
    </div>
  ) : (
    <form method="POST" action={actions.submitQuote} class="card space-y-4 p-6">
      <div>
        <p class="eyebrow text-brand-600">Get matched</p>
        <h3 class="mt-1 font-display text-xl uppercase tracking-tight text-ink">Request a quote</h3>
        <p class="mt-1 text-sm text-muted">
          Tell us about your project. We’ll route your request to {operatorName} (or another local fit).
        </p>
      </div>
      {result?.error && (
        <p class="border-2 border-red-600 bg-red-50 px-3 py-2 text-sm font-medium text-red-800" role="alert">
          {result.error.message}
        </p>
      )}
      <input type="hidden" name="operatorId" value={operatorId} />
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="label" for="seekerName">Your name *</label>
          <input class="input" id="seekerName" name="seekerName" required autocomplete="name" />
        </div>
        <div>
          <label class="label" for="seekerEmail">Email *</label>
          <input class="input" id="seekerEmail" name="seekerEmail" type="email" required autocomplete="email" />
        </div>
        <div>
          <label class="label" for="seekerPhone">Phone</label>
          <input class="input" id="seekerPhone" name="seekerPhone" type="tel" autocomplete="tel" />
        </div>
        <div>
          <label class="label" for="projectSize">Dumpster size</label>
          <select class="input" id="projectSize" name="projectSize">
            <option value="">Not sure</option>
            {DUMPSTER_SIZES.map((s) => (
              <option value={`${s}`} selected={defaultSize === String(s)}>
                {s} yard
              </option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="material">Material</label>
          <select class="input" id="material" name="material">
            <option value="">Select…</option>
            {MATERIALS.map((m) => (
              <option value={m.id}>{m.label}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label" for="addressOrZip">Address or ZIP</label>
          <input class="input" id="addressOrZip" name="addressOrZip" value={defaultZip} autocomplete="postal-code" />
        </div>
        <div>
          <label class="label" for="timeline">Timeline</label>
          <input class="input" id="timeline" name="timeline" placeholder="e.g. this weekend, ASAP" />
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="notes">Project notes</label>
          <textarea class="input min-h-[88px]" id="notes" name="notes" rows="3" />
        </div>
      </div>
      <button type="submit" class="btn-primary w-full sm:w-auto">Submit quote request</button>
      <p class="text-xs text-muted">
        By submitting, you agree we may share these details with verified local operators for quoting
        purposes.
      </p>
    </form>
  )
}
