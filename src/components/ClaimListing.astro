---
import { actions } from 'astro:actions';
import { loginPath, organizationName } from '../lib/auth';

interface Props {
  operatorId: string;
  operatorName: string;
  claimStatus: string;
}

const { operatorId, operatorName, claimStatus } = Astro.props;
const result = Astro.getActionResult(actions.claimListing);
const canClaim = claimStatus === 'unclaimed' || claimStatus === 'rejected';
const auth = Astro.locals.auth;
const here = `${Astro.url.pathname}#claim`;
const orgName = canClaim && auth?.orgId ? await organizationName(auth.orgId) : null;
const chooseCompany = `/portal/select-org?${new URLSearchParams({ returnTo: here })}`;
---

<div class="card p-5" id="claim">
  <p class="font-mono text-xs font-bold uppercase tracking-widest text-ink">Own this listing?</p>
  {
    claimStatus === 'approved' && (
      <p class="mt-2 text-sm text-muted">
        This listing is claimed.{' '}
        <a href="/portal">Open operator portal</a>
      </p>
    )
  }
  {
    claimStatus === 'pending' && (
      <p class="mt-2 text-sm text-amber-800">
        A claim for {operatorName} is pending admin review.
      </p>
    )
  }
  {
    canClaim && (
      <>
        <p class="mt-2 text-sm text-charcoal-700">
          Claim {operatorName} with your company account to unlock leads and update your profile.
          Signing in with the listing’s email (or an email on its website domain) approves the claim
          instantly.
        </p>
        {!auth && (
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={loginPath(here)} class="btn-secondary text-xs">Sign in</a>
            <a href={loginPath(here, { signUp: true })} class="btn-secondary text-xs">Sign up</a>
          </div>
        )}
        {auth && !auth.orgId && (
          <div class="mt-4 space-y-3">
            <p class="text-xs text-muted">Choose or create your company, then submit the claim.</p>
            <a href={chooseCompany} class="btn-secondary text-xs">Choose company</a>
          </div>
        )}
        {auth?.orgId && (
          <div class="mt-4 space-y-3">
            <p class="text-xs text-muted">
              Claiming as <strong class="text-ink">{orgName ?? 'your company'}</strong>.{' '}
              <a href={chooseCompany}>Change company</a>
            </p>
            {result?.error && (
              <p class="border-2 border-red-600 bg-red-50 px-3 py-2 text-sm text-red-800">
                {result.error.message}
              </p>
            )}
            {result?.data?.ok && result.data.autoApproved ? (
              <p class="border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
                Claim approved — your verified email matches this listing.{' '}
                <a href="/portal/leads">Open your leads</a>
              </p>
            ) : result?.data?.ok ? (
              <p class="border-2 border-brand-600 bg-brand-50 px-3 py-2 text-sm text-brand-800">
                Claim submitted — we’ll email you when it’s reviewed. Tip: claims approve instantly
                when you sign in with the listing’s email or an email on its website domain.
              </p>
            ) : (
              <form method="POST" action={actions.claimListing} class="space-y-3">
                <input type="hidden" name="operatorId" value={operatorId} />
                <div>
                  <label class="label" for="claim-message">Message (optional)</label>
                  <textarea class="input" id="claim-message" name="message" rows="2" />
                </div>
                <button type="submit" class="btn-secondary text-xs">
                  Submit claim
                </button>
              </form>
            )}
          </div>
        )}
      </>
    )
  }
</div>
