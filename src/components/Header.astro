---
import { BRAND } from '../lib/constants';

const path = Astro.url.pathname;
const links = [
  { href: '/search', label: 'Search' },
  { href: '/guides', label: 'Guides' },
];
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-white/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 text-ink no-underline hover:text-ink">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white"
        aria-hidden="true"
      >
        DL
      </span>
      <span class="text-lg font-bold tracking-tight">{BRAND.name}</span>
    </a>
    <nav class="hidden items-center gap-1 sm:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium no-underline',
              path.startsWith(l.href)
                ? 'bg-brand-50 text-brand-800'
                : 'text-slate-600 hover:bg-surface hover:text-ink',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a href="/search" class="btn-primary text-sm sm:hidden">Search</a>
  </div>
</header>
