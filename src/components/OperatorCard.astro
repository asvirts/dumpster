---
import type { OperatorResult } from '../lib/search';
import { formatCurrency, formatPhone } from '../lib/geo';
import { MATERIALS } from '../lib/constants';
import VerifiedBadge from './VerifiedBadge.astro';

interface Props {
  operator: OperatorResult;
  selected?: boolean;
}

const { operator: op, selected = false } = Astro.props;

const materialLabels = op.materials
  .map((id) => MATERIALS.find((m) => m.id === id)?.label ?? id)
  .slice(0, 3);

const priceLabel =
  op.pricingMin != null && op.pricingMax != null
    ? `${formatCurrency(op.pricingMin)}–${formatCurrency(op.pricingMax)}`
    : 'Request quote';
---

<article
  class:list={[
    'card p-5',
    selected && 'outline-2 outline-offset-2 outline-brand-500',
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-lg font-bold text-ink">
        <a href={`/operator/${op.slug}`} class="text-ink no-underline hover:text-brand-600">
          {op.name}
        </a>
      </h2>
      <p class="mt-1 font-mono text-xs uppercase tracking-wider text-muted">
        {[op.hqCity, op.hqState].filter(Boolean).join(', ') || 'Local operator'}
        {
          op.distanceMiles != null && (
            <span> · ~{op.distanceMiles.toFixed(1)} mi</span>
          )
        }
      </p>
    </div>
    <div class="text-right">
      <p class="font-mono text-lg font-bold text-brand-600">{priceLabel}</p>
      <p class="font-mono text-[10px] uppercase tracking-widest text-muted">Typical range</p>
    </div>
  </div>

  <div class="mt-3">
    <VerifiedBadge
      lastVerifiedAt={op.verificationStatus === 'verified' ? op.lastVerifiedAt : null}
      isBroker={op.isBroker}
      isDemo={op.isDemo}
    />
  </div>

  {
    op.description && (
      <p class="mt-3 line-clamp-2 text-sm text-charcoal-600">{op.description}</p>
    )
  }

  <div class="mt-4 flex flex-wrap gap-1.5">
    {
      op.sizes.map((s) => (
        <span class="chip bg-charcoal-900 text-brand-400">{s} yd</span>
      ))
    }
    {
      materialLabels.map((m) => (
        <span class="chip border-2 border-charcoal-200 text-charcoal-600">{m}</span>
      ))
    }
    {
      op.drivewaySuitable && (
        <span class="chip border-2 border-brand-500 text-brand-700">Driveway-safe</span>
      )
    }
    {
      op.sameDayCapable && (
        <span class="chip border-2 border-brand-500 text-brand-700">Same-day</span>
      )
    }
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2 border-t-2 border-charcoal-100 pt-4">
    <a href={`/operator/${op.slug}`} class="btn-primary">View profile</a>
    {
      op.phone && (
        <a href={`tel:${op.phone}`} class="btn-secondary font-mono normal-case tracking-normal">
          {formatPhone(op.phone)}
        </a>
      )
    }
    <label class="ml-auto flex cursor-pointer items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-muted">
      <input
        type="checkbox"
        name="compare"
        value={op.id}
        data-compare-id={op.id}
        data-compare-name={op.name}
        class="compare-check h-4 w-4"
      />
      Compare
    </label>
  </div>
</article>
