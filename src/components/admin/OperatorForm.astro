---
import { DUMPSTER_SIZES, MATERIALS, VERIFICATION_STATUSES } from '../../lib/constants';
import type { City, Operator } from '../../lib/schema';

interface Props {
  operator?: Operator | null;
  sizes?: number[];
  materials?: string[];
  cityIds?: string[];
  cities: City[];
  action: string;
}

const {
  operator,
  sizes = [],
  materials = [],
  cityIds = [],
  cities,
  action,
} = Astro.props;
---

<form method="POST" action={action} class="space-y-6">
  <div class="card grid gap-4 p-6 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label class="label" for="name">Name *</label>
      <input class="input" id="name" name="name" required value={operator?.name ?? ''} />
    </div>
    <div>
      <label class="label" for="slug">Slug</label>
      <input class="input" id="slug" name="slug" value={operator?.slug ?? ''} placeholder="auto from name" />
    </div>
    <div>
      <label class="label" for="phone">Phone</label>
      <input class="input" id="phone" name="phone" value={operator?.phone ?? ''} />
    </div>
    <div>
      <label class="label" for="email">Email</label>
      <input class="input" id="email" name="email" type="email" value={operator?.email ?? ''} />
    </div>
    <div>
      <label class="label" for="website">Website</label>
      <input class="input" id="website" name="website" value={operator?.website ?? ''} />
    </div>
    <div class="sm:col-span-2">
      <label class="label" for="description">Description</label>
      <textarea class="input min-h-[100px]" id="description" name="description">{operator?.description ?? ''}</textarea>
    </div>
    <div>
      <label class="label" for="hqCity">HQ city</label>
      <input class="input" id="hqCity" name="hqCity" value={operator?.hqCity ?? ''} />
    </div>
    <div>
      <label class="label" for="hqState">HQ state</label>
      <input class="input" id="hqState" name="hqState" maxlength="2" value={operator?.hqState ?? ''} />
    </div>
    <div>
      <label class="label" for="hqLat">HQ lat</label>
      <input class="input" id="hqLat" name="hqLat" type="number" step="any" value={operator?.hqLat ?? ''} />
    </div>
    <div>
      <label class="label" for="hqLng">HQ lng</label>
      <input class="input" id="hqLng" name="hqLng" type="number" step="any" value={operator?.hqLng ?? ''} />
    </div>
    <div>
      <label class="label" for="pricingMin">Pricing min</label>
      <input class="input" id="pricingMin" name="pricingMin" type="number" step="1" value={operator?.pricingMin ?? ''} />
    </div>
    <div>
      <label class="label" for="pricingMax">Pricing max</label>
      <input class="input" id="pricingMax" name="pricingMax" type="number" step="1" value={operator?.pricingMax ?? ''} />
    </div>
    <div class="sm:col-span-2">
      <label class="label" for="pricingNotes">Pricing notes</label>
      <textarea class="input" id="pricingNotes" name="pricingNotes" rows="2">{operator?.pricingNotes ?? ''}</textarea>
    </div>
    <div>
      <label class="label" for="includedTonnage">Included tonnage</label>
      <input class="input" id="includedTonnage" name="includedTonnage" type="number" step="0.1" value={operator?.includedTonnage ?? ''} />
    </div>
    <div>
      <label class="label" for="overageRate">Overage $/ton</label>
      <input class="input" id="overageRate" name="overageRate" type="number" step="1" value={operator?.overageRate ?? ''} />
    </div>
    <div>
      <label class="label" for="qualityScore">Quality score (0–100)</label>
      <input class="input" id="qualityScore" name="qualityScore" type="number" min="0" max="100" value={operator?.qualityScore ?? 50} />
    </div>
    <div>
      <label class="label" for="verificationStatus">Verification status</label>
      <select class="input" id="verificationStatus" name="verificationStatus">
        {
          VERIFICATION_STATUSES.map((s) => (
            <option value={s} selected={(operator?.verificationStatus ?? 'pending') === s}>
              {s}
            </option>
          ))
        }
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class="label" for="verificationNotes">Verification notes</label>
      <textarea class="input" id="verificationNotes" name="verificationNotes" rows="2">{operator?.verificationNotes ?? ''}</textarea>
    </div>
    <div class="sm:col-span-2">
      <label class="label" for="drivewayNotes">Driveway notes</label>
      <input class="input" id="drivewayNotes" name="drivewayNotes" value={operator?.drivewayNotes ?? ''} />
    </div>
    <div class="sm:col-span-2">
      <label class="label" for="licenseNotes">License notes</label>
      <input class="input" id="licenseNotes" name="licenseNotes" value={operator?.licenseNotes ?? ''} />
    </div>
    <div class="sm:col-span-2 flex flex-wrap gap-4 text-sm">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="drivewaySuitable" checked={operator?.drivewaySuitable ?? false} />
        Driveway suitable
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="sameDayCapable" checked={operator?.sameDayCapable ?? false} />
        Same-day capable
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="isBroker" checked={operator?.isBroker ?? false} />
        Is broker
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="insuranceVerified" checked={operator?.insuranceVerified ?? false} />
        Insurance verified
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="isPublished" checked={operator?.isPublished ?? false} />
        Published
      </label>
    </div>
  </div>

  <div class="card p-6">
    <p class="label">Sizes offered</p>
    <div class="mt-2 flex flex-wrap gap-3">
      {
        DUMPSTER_SIZES.map((s) => (
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="sizes" value={s} checked={sizes.includes(s)} />
            {s} yd
          </label>
        ))
      }
    </div>
  </div>

  <div class="card p-6">
    <p class="label">Materials</p>
    <div class="mt-2 flex flex-wrap gap-3">
      {
        MATERIALS.map((m) => (
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="materials" value={m.id} checked={materials.includes(m.id)} />
            {m.label}
          </label>
        ))
      }
    </div>
  </div>

  <div class="card p-6">
    <p class="label">Service cities</p>
    <div class="mt-2 grid max-h-48 gap-2 overflow-y-auto sm:grid-cols-2">
      {
        cities.map((c) => (
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="cityIds" value={c.id} checked={cityIds.includes(c.id)} />
            {c.name}, {c.state}
          </label>
        ))
      }
    </div>
  </div>

  <button type="submit" class="btn-primary">Save operator</button>
</form>
