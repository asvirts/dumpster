---
import { BRAND } from '../lib/constants';
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="container-page grid gap-8 py-12 sm:grid-cols-3">
    <div>
      <p class="text-lg font-bold text-ink">{BRAND.name}</p>
      <p class="mt-2 text-sm text-muted">{BRAND.tagline}</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/search" class="text-muted no-underline hover:text-brand-700">Search operators</a></li>
        <li><a href="/guides" class="text-muted no-underline hover:text-brand-700">Guides</a></li>
        <li>
          <a href="/guides/dumpster-size-guide" class="text-muted no-underline hover:text-brand-700"
            >Size guide</a
          >
        </li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Quality promise</p>
      <p class="mt-3 text-sm text-muted">
        We prioritize verified local operators, last-verified dates, and transparent pricing over raw listing
        volume.
      </p>
    </div>
  </div>
  <div class="border-t border-border py-4 text-center text-xs text-muted">
    © {new Date().getFullYear()} {BRAND.name}. Demo data is for illustration until listings are replaced with
    real verified operators.
  </div>
</footer>
