---
import { DUMPSTER_SIZES, MATERIALS } from '../lib/constants';

interface Props {
  q?: string;
  size?: string;
  material?: string;
  driveway?: string;
  sameDay?: string;
  verified?: string;
  brokers?: string;
  sort?: string;
}

const {
  q = '',
  size = '',
  material = '',
  driveway = '',
  sameDay = '',
  verified = '1',
  brokers = '0',
  sort = 'quality',
} = Astro.props;
---

<form method="get" action="/search" class="card space-y-5 p-5">
  <input type="hidden" name="q" value={q} />
  <p class="eyebrow border-b-2 border-charcoal-900 pb-3 text-ink">Filters</p>
  <div>
    <label class="label" for="filter-size">Dumpster size</label>
    <select id="filter-size" name="size" class="input">
      <option value="">Any size</option>
      {DUMPSTER_SIZES.map((s) => (
        <option value={s} selected={size === String(s)}>{s} yard</option>
      ))}
    </select>
  </div>
  <div>
    <label class="label" for="filter-material">Material</label>
    <select id="filter-material" name="material" class="input">
      <option value="">Any material</option>
      {MATERIALS.map((m) => (
        <option value={m.id} selected={material === m.id}>{m.label}</option>
      ))}
    </select>
  </div>
  <div>
    <label class="label" for="filter-sort">Sort by</label>
    <select id="filter-sort" name="sort" class="input">
      <option value="quality" selected={sort === 'quality'}>Quality score</option>
      <option value="price" selected={sort === 'price'}>Price (low to high)</option>
      <option value="distance" selected={sort === 'distance'}>Distance</option>
    </select>
  </div>
  <fieldset class="space-y-2.5 border-t-2 border-charcoal-100 pt-4">
    <legend class="label sr-only">Options</legend>
    <label class="flex items-center gap-2 text-sm font-medium text-charcoal-700">
      <input type="checkbox" name="driveway" value="1" checked={driveway === '1'} class="h-4 w-4" />
      Residential driveway-safe
    </label>
    <label class="flex items-center gap-2 text-sm font-medium text-charcoal-700">
      <input type="checkbox" name="sameDay" value="1" checked={sameDay === '1'} class="h-4 w-4" />
      Same-day capable
    </label>
    <label class="flex items-center gap-2 text-sm font-medium text-charcoal-700">
      <input type="checkbox" name="verified" value="1" checked={verified !== '0'} class="h-4 w-4" />
      Verified only
    </label>
    <label class="flex items-center gap-2 text-sm font-medium text-charcoal-700">
      <input type="checkbox" name="brokers" value="1" checked={brokers === '1'} class="h-4 w-4" />
      Include brokers
    </label>
  </fieldset>
  <button type="submit" class="btn-primary w-full">Apply filters</button>
</form>
