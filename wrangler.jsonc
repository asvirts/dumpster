{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findadumpster",
  // Custom entry = Astro fetch handler + scheduled() for the lead autopilot.
  "main": "./src/worker.ts",
  "triggers": {
    // Every 15 min: route/expand/remind/expire leads. 14:00 UTC daily: revenue digest.
    "crons": ["*/15 * * * *", "0 14 * * *"]
  },
  "compatibility_date": "2025-10-01",
  // global_fetch_strictly_public: required so env.ASSETS.fetch() works on workers.dev
  // (error 1042 without it — Worker-to-assets same-zone fetch)
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Static files from public/ (ads.txt, favicons, etc.) are served by the
  // Assets pipeline first — they do NOT go through the Worker/auth middleware.
  // Do not set run_worker_first: true or ads.txt would be Worker-proxied.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dumpsterlocal",
      "database_id": "1c8dbaa7-18c4-4120-ae94-a47c97ac3717",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_SITE_NAME": "Find A Dumpster",
    "PUBLIC_SITE_URL": "https://findadumpster.net",
    // WorkOS "Find A Dumpster" Production environment (public client ID).
    // Secrets: WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD. Local .dev.vars overrides with Staging.
    "WORKOS_CLIENT_ID": "client_01M8CSW40W3D5M2EFCETV42KTD",
    "LEAD_FROM_EMAIL": "Find A Dumpster <leads@findadumpster.net>",
    // Replies land in Resend Inbound → /api/resend/inbound → /admin/replies.
    "LEAD_REPLY_TO": "leads@eeildoiint.resend.app"
  }
}
