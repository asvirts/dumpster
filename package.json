{
  "name": "findadumpster",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "void prepare && tsc --noEmit && pnpm typecheck:vue",
    "typecheck:vue": "pnpm dlx --package=typescript@6.0.3 --package=vue-tsc@3.3.14 vue-tsc --noEmit -p .",
    "verify": "pnpm typecheck && vp test",
    "release": "pnpm db:migrate:remote && void deploy --platform cloudflare --skip-migrations",
    "db:migrate:local": "wrangler d1 migrations apply dumpsterlocal --local --config wrangler.d1.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply dumpsterlocal --remote --config wrangler.d1.jsonc",
    "db:seed:local": "wrangler d1 execute dumpsterlocal --local --file=./seed/seed.sql --config wrangler.d1.jsonc --persist-to .wrangler/state",
    "db:seed:remote": "wrangler d1 execute dumpsterlocal --remote --file=./seed/seed.sql --config wrangler.d1.jsonc",
    "db:setup:local": "pnpm db:migrate:local && pnpm db:seed:local",
    "stripe:listen": "stripe listen --forward-to localhost:4321/api/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed",
    "postinstall": "void prepare",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@workos-inc/node": "12.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.19",
    "maplibre-gl": "^6.2.0",
    "nanoid": "^6.0.1",
    "stripe": "22.4.0",
    "vue": "^3.5.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@void/vue": "1.12.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0",
    "void": "1.12.0",
    "wrangler": "^4.120.0"
  }
}
