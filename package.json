{
  "name": "findadumpster",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/patch-astro-workerd.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply dumpsterlocal --local",
    "db:migrate:remote": "wrangler d1 migrations apply dumpsterlocal --remote",
    "db:seed:local": "wrangler d1 execute dumpsterlocal --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute dumpsterlocal --remote --file=./seed/seed.sql",
    "db:setup:local": "bun run db:migrate:local && bun run db:seed:local",
    "types": "wrangler types",
    "test": "bun test",
    "stripe:listen": "stripe listen --forward-to localhost:4332/api/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed",
    "deploy": "bun run build && wrangler deploy",
    "postinstall": "node scripts/patch-astro-workerd.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/react": "^6.0.2",
    "@clerk/astro": "^4.0.8",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^6.2.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
