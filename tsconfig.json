{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["void/env", "vite/client", "@cloudflare/workers-types"],
    "jsx": "preserve"
  },
  "include": ["src", "pages", "routes", "middleware", "crons", "env.d.ts", "*.ts"]
}
